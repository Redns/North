@inherits LayoutComponentBase

@inject NavigationManager navigationManager
@inject IHttpClientFactory httpClientFactory
@inject IPWAUpdaterService PWAUpdaterService
@inject AppThemeState ThemeState

@implements IDisposable

<MudStack Spacing="0" Style="height:50px;">
    <ActionToolBar IsExpanded="@IsExpanded" ThemeMode="@ThemeState.ThemeMode" Title="North"
                   OnNavMenuStateChanged="(() => IsExpanded = !IsExpanded)" OnSwitchTheme="@SwitchTheme"
                   OnUserClick="@(() => SignOut())" />
    <MudDivider />
</MudStack>
<MudStack Row Spacing="0" Style="position: absolute; top: 50px; bottom: 0; left: 0; right:0; user-select: none;">
    <NavMenu IsExpanded="@IsExpanded" OpenMiniOnHover="@OpenMiniOnHover" Style="width:240px;" />
    <MudStack Spacing="0" Class="mud-height-full mud-width-full">
        @if (string.IsNullOrWhiteSpace(FooterText))
        {
            @Body
        }
        else
        {
            <MudStack Class="mud-width-full" Style="height:calc(100% - 40px);">
                @Body
            </MudStack>
            <FooterText Content="@FooterText" Style="height:40px; text-align:center;" Class="footer-text" />
        }
    </MudStack>
</MudStack>

<PWAUpdater Text="" ButtonCaption="立即更新" Align="PWAUpdater.Aligns.Bottom">
    <p>@ReleaseNotesText</p>
</PWAUpdater>

<AppThemeProvider PersistThemeModeIfMissing="true" />
