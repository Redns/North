<PageTitle>@AppName</PageTitle>

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <MudStack Spacing="0" Class="mud-height-full mud-width-full" Style="min-height: 100vh;" Justify="Justify.Center"
                  AlignItems="AlignItems.Center">
            <MudStack Style="margin-bottom: 200px;" Class="mud-width-full" AlignItems="AlignItems.Center">
                <MudImage Src="icons/404.svg" Width="180" Height="180" />
                <MudText Typo="Typo.h5" Inline Style="color: #9E9E9E !important;">
                    目标地址不存在，
                    <MudLink Href="/" Typo="Typo.h5" Style="color: #34C8C9 !important;">点击此处</MudLink>
                    返回首页
                </MudText>
            </MudStack>
            @if (!string.IsNullOrWhiteSpace(FooterText))
            {
                <FooterText Content="@FooterText"
                            Style="height:40px; text-align:center; position: absolute; bottom: 0; width: 100%;" />
            }
        </MudStack>
    </NotFound>
</Router>

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
