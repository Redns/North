@using Microsoft.JSInterop
@using MudBlazor
@using North.RCL.Texts

<MudToolBar Style="@Style">
    <MudTooltip Text="@(IsExpanded ? "收起" : "展开")" Placement="Placement.Right">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu"
                       OnClick="@OnNavMenuStateChanged" Ripple="false" Style="margin-left:-20px;" />
    </MudTooltip>
    <TitleText Text="@Title" Style="margin-left:10px; font-size:22px; user-select:none; font-weight:450;" />
    <MudSpacer />
    <MudTooltip Text="通知">
        <MudIconButton Icon="@Icons.Material.Outlined.Notifications" />
    </MudTooltip>
    <MudTooltip Text="用户">
        <MudIconButton Icon="@Icons.Material.Outlined.ManageAccounts" OnClick="@OnUserClick" />
    </MudTooltip>
    <MudTooltip Text="@ThemeSwitchTooltip">
        <MudIconButton Icon="@ThemeSwitchIcon" OnClick="@OnSwitchTheme" />
    </MudTooltip>
</MudToolBar>